<div class="min-h-screen bg-slate-50 text-slate-900">
  <header class="border-b border-slate-200 bg-slate-50">
    <div class="mx-auto flex h-12 max-w-4xl items-center px-4 sm:px-6">
      <%= link_to "Timezone Scheduler", root_path, class: "text-base font-bold tracking-tight sm:text-lg" %>
    </div>
  </header>

  <main class="mx-auto grid max-w-4xl gap-4 px-4 py-16 sm:px-6 sm:py-24">
    <p class="text-sm font-bold uppercase tracking-[0.2em] text-brand-700">404</p>
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Page not found</h1>
    <p class="max-w-xl text-slate-600">This event page may have been deleted or the link may be incorrect.</p>
    <%= link_to "Back to home", root_path, class: "w-fit text-sm font-bold text-brand-700 underline underline-offset-4 hover:text-brand-800" %>
  </main>
</div>
