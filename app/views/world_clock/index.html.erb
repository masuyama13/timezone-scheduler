<% content_for :title, "World Clock | Timezone Scheduler" %>

<div class="min-h-screen bg-slate-50 text-slate-900">
  <header class="border-b border-slate-200 bg-slate-50">
    <div class="mx-auto flex h-12 max-w-5xl items-center px-4 sm:px-6">
      <h1 class="text-base font-bold tracking-tight sm:text-lg">Timezone Scheduler</h1>
    </div>
  </header>

  <main class="mx-auto grid max-w-5xl gap-6 px-4 py-6 sm:px-6 sm:py-8">
    <section aria-labelledby="world-clock-heading">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-xs font-extrabold uppercase tracking-[0.08em] text-indigo-600">World Clock</p>
          <h2 id="world-clock-heading" class="mt-1 text-xl font-bold tracking-tight sm:text-2xl">Select cities</h2>
        </div>
        <span class="shrink-0 text-sm text-slate-500">0 of 10 cities</span>
      </div>

      <div class="mt-6 flex min-h-32 items-center justify-center border-y border-dashed border-slate-300 py-6">
        <p class="text-center text-slate-500">Choose your city to start comparing local time.</p>
      </div>

      <div class="mt-6 flex flex-wrap gap-3">
        <button type="button" class="rounded-xl bg-blue-700 px-4 py-3 font-bold text-white shadow-sm transition hover:bg-blue-800 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">Add city</button>
      </div>
    </section>

    <section aria-labelledby="next-step-heading">
      <p class="text-xs font-extrabold uppercase tracking-[0.08em] text-indigo-600">Next step</p>
      <h2 id="next-step-heading" class="mt-1 text-xl font-bold tracking-tight sm:text-2xl">Plan a meeting</h2>
      <button type="button" disabled class="mt-4 cursor-not-allowed rounded-xl bg-slate-300 px-4 py-3 font-bold text-slate-500">Plan a meeting</button>
    </section>
  </main>
</div>
