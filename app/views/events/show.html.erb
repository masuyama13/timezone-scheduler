<% content_for :title, "#{@event.name} | Timezone Scheduler" %>

<% share_url = request.base_url + event_path(@event.public_token) %>
<div class="min-h-screen bg-slate-50 text-slate-900" data-controller="share-link" data-share-link-url-value="<%= share_url %>">
  <header class="border-b border-slate-200 bg-slate-50">
    <div class="mx-auto flex h-12 max-w-4xl items-center px-4 sm:px-6">
      <%= link_to "Timezone Scheduler", root_path, class: "text-base font-bold tracking-tight sm:text-lg" %>
    </div>
  </header>

  <main class="mx-auto grid max-w-4xl gap-8 px-4 py-6 sm:px-6 sm:py-8">
    <section class="grid gap-3">
      <h1 class="text-2xl font-bold tracking-tight sm:text-3xl"><%= @event.name %></h1>
      <% if @event.description.present? %>
        <p class="whitespace-pre-wrap text-slate-600"><%= @event.description %></p>
      <% end %>
    </section>

    <section class="grid gap-3" aria-labelledby="share-link-heading">
      <h2 id="share-link-heading" class="text-lg font-bold">Share this event</h2>
      <div class="flex flex-col gap-2 sm:flex-row">
        <input data-share-link-target="url" type="text" readonly value="<%= share_url %>" class="min-w-0 flex-1 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-600">
        <button type="button" data-action="click->share-link#copy" class="shrink-0 rounded-lg bg-blue-700 px-4 py-2 text-sm font-bold text-white hover:bg-blue-800">Copy link</button>
      </div>
      <p data-share-link-target="status" role="status" class="text-sm text-emerald-700"></p>
    </section>

    <section class="grid gap-4" aria-labelledby="time-options-heading">
      <h2 id="time-options-heading" class="text-lg font-bold">Time options</h2>
      <% @event.time_options.order(:starts_at).each_with_index do |time_option, index| %>
        <article class="rounded-xl border border-slate-200 bg-white p-4">
          <h3 class="text-base font-bold">Option <%= index + 1 %></h3>
          <div class="mt-3 grid gap-2">
            <% @event.event_cities.each do |city| %>
              <div class="flex items-baseline justify-between gap-4 border-b border-slate-100 py-2 last:border-b-0">
                <span class="font-bold text-slate-700"><%= city.name %></span>
                <time class="text-right text-sm text-slate-600"><%= time_option.starts_at.in_time_zone(city.time_zone).strftime("%a, %b %-d, %-I:%M %p") %></time>
              </div>
            <% end %>
          </div>
        </article>
      <% end %>
      <p class="text-xs text-slate-500">This page and its responses may be deleted after one year.</p>
    </section>

    <% if management_authorized?(@event) %>
      <section class="grid gap-3 border-t border-slate-200 pt-6" aria-labelledby="delete-event-heading">
        <h2 id="delete-event-heading" class="text-lg font-bold">Delete event</h2>
        <p class="text-sm text-slate-600">This will permanently delete this page, all time options, responses, and comments.</p>
        <%= button_to "Delete event", event_path(@event.public_token), method: :delete, data: { turbo_confirm: "Delete #{@event.name}? This will permanently delete the event and all responses." }, authenticity_token: false, class: "w-fit rounded-lg bg-red-700 px-4 py-2 text-sm font-bold text-white hover:bg-red-800" %>
      </section>
    <% end %>
  </main>
</div>
