<% content_for :title, "#{@event.name} | Timezone Scheduler" %>

<% share_url = request.base_url + event_path(@event.public_token) %>
<% compact_response_table = @event.time_options.size > 6 %>
<% name_column_class = compact_response_table ? "w-20" : "w-20 lg:w-28" %>
<% date_column_class = compact_response_table ? "w-16 max-w-16" : "w-16 max-w-16 lg:w-20 lg:max-w-20" %>
<% comment_column_class = compact_response_table ? "w-28 lg:w-28" : "w-28 lg:w-64 lg:max-w-64" %>
<div class="min-h-screen bg-slate-50 text-slate-900" data-controller="share-link" data-share-link-url-value="<%= share_url %>">
  <header class="border-b border-slate-200 bg-slate-50">
    <div class="mx-auto flex h-12 max-w-4xl items-center px-4 sm:px-6">
      <%= link_to "Timezone Scheduler", root_path, class: "text-base font-bold tracking-tight sm:text-lg" %>
    </div>
  </header>

  <main class="mx-auto grid max-w-4xl gap-8 px-4 py-6 sm:px-6 sm:py-8">
    <section class="flex items-start justify-between gap-4">
      <div class="grid gap-3">
        <h1 class="text-2xl font-bold tracking-tight sm:text-3xl"><%= @event.name %></h1>
        <% if @event.description.present? %>
          <p class="whitespace-pre-wrap text-slate-600"><%= @event.description %></p>
        <% end %>
      </div>
      <button type="button" data-action="click->share-link#copy" aria-label="Copy event link" title="Copy event link" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-slate-300 text-slate-600 hover:bg-slate-50">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5">
          <rect x="9" y="9" width="10" height="10" rx="1" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 15H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h9a1 1 0 0 1 1 1v1" />
        </svg>
      </button>
      <span data-share-link-target="status" role="status" class="sr-only"></span>
    </section>

    <section class="grid gap-4" aria-labelledby="responses-heading">
      <div class="flex items-baseline justify-between gap-4">
        <h2 id="responses-heading" class="text-lg font-bold">Responses</h2>
        <span class="text-sm text-slate-500"><%= pluralize(@responses.size, "response") %></span>
      </div>
      <% if @responses.empty? %>
        <p class="text-sm text-slate-600">No responses yet.</p>
      <% else %>
        <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white lg:overflow-x-hidden">
          <table class="w-max table-fixed border-collapse text-left text-sm lg:w-full">
            <thead>
              <tr class="border-b border-slate-200 text-slate-700">
                <th scope="col" class="<%= name_column_class %> break-words px-2 py-4 text-center text-sm font-bold">Name</th>
                <% @event.time_options.order(:starts_at).each do |time_option| %>
                  <th scope="col" class="<%= date_column_class %> border-l border-slate-200 px-1 py-3 text-center text-xs font-bold">
                    <%= time_option.starts_at.in_time_zone(@event.time_zone).strftime("%b %-d, %Y,") %><br>
                    <%= time_option.starts_at.in_time_zone(@event.time_zone).strftime("%-I:%M %p") %>
                  </th>
                <% end %>
                <th scope="col" class="<%= comment_column_class %> border-l border-slate-200 px-2 py-4 text-center text-sm font-bold">Comment</th>
              </tr>
            </thead>
            <tbody>
              <% @responses.each do |response| %>
                <% votes_by_time_option = response.votes.index_by(&:time_option_id) %>
                <tr class="border-b border-slate-200 last:border-b-0">
                  <th scope="row" class="break-words px-2 py-4 align-middle text-sm font-bold">
                    <span class="block"><%= response.name %></span>
                    <span class="mt-1 block text-xs font-normal text-slate-500"><%= city_name_for_time_zone(response.time_zone) %></span>
                  </th>
                  <% @event.time_options.order(:starts_at).each do |time_option| %>
                    <% vote = votes_by_time_option[time_option.id] %>
                    <td class="<%= date_column_class %> border-l border-slate-200 px-1 py-4 text-center text-xl font-bold" aria-label="<%= availability_label(vote&.availability) %>">
                      <%= availability_symbol(vote&.availability) %>
                    </td>
                  <% end %>
                  <td class="<%= comment_column_class %> break-words border-l border-slate-200 px-2 py-4 text-sm text-slate-600"><%= response.comment %></td>
                </tr>
              <% end %>
            </tbody>
            <tfoot>
              <tr class="border-t border-slate-200 text-orange-700">
                <th scope="row" class="px-4 py-4 text-sm font-bold">Available</th>
                <% @event.time_options.order(:starts_at).each do |time_option| %>
                  <td class="<%= date_column_class %> border-l border-slate-200 px-1 py-4 text-center text-lg font-bold"><%= availability_counts(time_option, @responses).fetch("Available") %></td>
                <% end %>
                <td class="border-l border-slate-200"></td>
              </tr>
            </tfoot>
          </table>
        </div>
      <% end %>
    </section>

    <section class="grid gap-4" aria-labelledby="response-heading" data-controller="event-response" data-event-response-url-value="<%= event_responses_path(@event.public_token) %>">
      <div>
        <h2 id="response-heading" class="text-lg font-bold">Share your availability</h2>
      </div>
      <form data-event-response-target="form" data-action="submit->event-response#submit" class="grid gap-4 rounded-xl border border-slate-200 bg-white p-4">
        <div class="grid gap-2">
          <label for="response-name" class="text-sm font-bold">Name</label>
          <input id="response-name" name="name" type="text" required maxlength="50" data-event-response-target="name" class="rounded-lg border border-slate-300 px-3 py-2">
        </div>
        <div class="grid gap-2">
          <label for="response-time-zone" class="text-sm font-bold">Your time zone</label>
          <select id="response-time-zone" name="time_zone" required data-event-response-target="timeZone" data-event-response-fallback-time-zone-value="<%= @event.time_zone %>" class="sr-only"></select>
          <button type="button" data-event-response-target="timeZoneButton" data-action="click->event-response#openTimeZoneSearch" class="flex w-full items-center justify-between rounded-lg border border-slate-300 bg-white px-3 py-2 text-left text-sm hover:bg-slate-50">
            <span data-event-response-target="timeZoneLabel"></span>
            <span aria-hidden="true">⌄</span>
          </button>
        </div>
        <div data-event-response-target="timeZoneDialog" role="dialog" aria-modal="true" aria-labelledby="response-time-zone-heading" hidden>
          <div class="fixed inset-0 z-50 flex items-center justify-center p-4">
            <div class="absolute inset-0 bg-slate-950/50" data-action="click->event-response#closeTimeZoneSearch"></div>
            <div class="relative z-10 h-[28rem] w-[calc(100%-2rem)] max-w-lg overflow-y-auto rounded-2xl bg-white p-5 shadow-2xl sm:p-6">
              <div class="flex items-center justify-between gap-4">
                <h3 id="response-time-zone-heading" class="text-lg font-bold">Search cities</h3>
                <button type="button" aria-label="Close" title="Close" class="flex h-8 w-8 items-center justify-center rounded-lg text-blue-700 hover:bg-blue-50 focus:outline-none focus:ring-2 focus:ring-blue-500" data-action="click->event-response#closeTimeZoneSearch">
                  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" /></svg>
                </button>
              </div>
              <label for="response-time-zone-search" class="mt-5 block text-sm font-bold">City or country</label>
              <input id="response-time-zone-search" type="search" autocomplete="off" placeholder="Tokyo or Canada" data-event-response-target="timeZoneSearch" data-action="input->event-response#searchTimeZones" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 outline-none focus:border-blue-600 focus:ring-2 focus:ring-blue-200">
              <div data-event-response-target="timeZoneResults" class="mt-3 grid gap-2" aria-live="polite"></div>
            </div>
          </div>
        </div>
        <fieldset class="grid gap-3">
          <legend class="text-sm font-bold">Availability</legend>
          <% @event.time_options.order(:starts_at).each do |time_option| %>
            <div class="grid grid-cols-[minmax(0,1fr)_9rem] items-center gap-3 border-t border-slate-100 pt-3" data-time-option-id="<%= time_option.id %>">
              <p class="min-w-0 text-sm font-bold"><%= time_option.starts_at.in_time_zone(@event.time_zone).strftime("%b %-d, %-I:%M %p") %></p>
              <div class="grid grid-cols-3 gap-1.5">
                <% [["available", "✓"], ["maybe", "?"], ["unavailable", "×"]].each do |value, icon| %>
                  <label class="group flex h-12 cursor-pointer items-center justify-center rounded-lg border border-slate-300 bg-white text-xl font-bold text-slate-700 transition hover:border-blue-500 hover:bg-blue-50 has-[:checked]:border-blue-700 has-[:checked]:bg-blue-50 has-[:checked]:text-blue-700">
                    <input class="peer sr-only" type="radio" name="availability-<%= time_option.id %>" value="<%= value %>" aria-label="<%= value.humanize %>" required>
                    <span aria-hidden="true"><%= icon %></span>
                    <span class="sr-only"><%= value.humanize %></span>
                  </label>
                <% end %>
              </div>
            </div>
          <% end %>
        </fieldset>
        <div class="grid gap-2">
          <label for="response-comment" class="text-sm font-bold">Comment <span class="font-normal text-slate-500">(optional)</span></label>
          <textarea id="response-comment" name="comment" rows="2" maxlength="400" data-event-response-target="comment" class="rounded-lg border border-slate-300 px-3 py-2"></textarea>
        </div>
        <button type="button" data-action="click->event-response#submit" data-event-response-target="submit" class="w-fit rounded-lg bg-blue-700 px-4 py-2 text-sm font-bold text-white hover:bg-blue-800 disabled:cursor-wait disabled:opacity-60">Submit</button>
        <p data-event-response-target="status" role="status" class="text-sm text-amber-700"></p>
      </form>
    </section>

    <p class="text-xs text-slate-500">This page and its responses may be deleted after one year.</p>

    <% if management_authorized?(@event) %>
      <section class="grid gap-3 border-t border-slate-200 pt-6" aria-labelledby="delete-event-heading">
        <h2 id="delete-event-heading" class="text-lg font-bold">Delete event</h2>
        <p class="text-sm text-slate-600">This will permanently delete this page, all time options, responses, and comments.</p>
        <%= button_to "Delete event", event_path(@event.public_token), method: :delete, data: { turbo_confirm: "Delete #{@event.name}? This will permanently delete the event and all responses." }, authenticity_token: false, class: "w-fit rounded-lg bg-red-700 px-4 py-2 text-sm font-bold text-white hover:bg-red-800" %>
      </section>
    <% end %>
  </main>
</div>
