<% content_for :title, "#{@event.name} | Timezone Scheduler" %>

<% share_url = request.base_url + event_path(@event.public_token) %>
<% compact_response_table = @event.time_options.size > 6 %>
<% name_column_class = compact_response_table ? "w-20" : "w-20 lg:w-28" %>
<% date_column_class = compact_response_table ? "w-16 max-w-16" : "w-16 max-w-16 lg:w-20 lg:max-w-20" %>
<% comment_column_class = compact_response_table ? "w-28 lg:w-28" : "w-28 lg:w-64 lg:max-w-64" %>
<% time_options = @event.time_options.order(:starts_at) %>
<% available_counts = time_options.to_h { |time_option| [time_option.id, availability_counts(time_option, @responses).fetch("Available")] } %>
<% maximum_available = available_counts.values.max %>
<div class="min-h-screen bg-slate-50 text-slate-900" data-controller="share-link" data-share-link-url-value="<%= share_url %>">
  <header class="border-b border-slate-200 bg-slate-50">
    <div class="mx-auto flex h-12 max-w-4xl items-center px-4 sm:px-6">
      <%= link_to "Timezone Scheduler", root_path, class: "text-base font-bold tracking-tight sm:text-lg" %>
    </div>
  </header>

  <main class="mx-auto grid max-w-4xl gap-8 px-4 py-6 sm:px-6 sm:py-8" data-controller="event-response" data-event-response-url-value="<%= event_responses_path(@event.public_token) %>" data-event-response-update-url-template-value="<%= event_response_path(@event.public_token, "RESPONSE_ID") %>" data-event-response-fallback-time-zone-value="<%= @event.time_zone %>">
    <section class="flex items-start justify-between gap-4">
      <div class="grid gap-3">
        <h1 class="text-2xl font-bold tracking-tight sm:text-3xl"><%= @event.name %></h1>
        <% if @event.description.present? %>
          <p class="whitespace-pre-wrap text-slate-600"><%= @event.description %></p>
        <% end %>
      </div>
      <button type="button" data-action="click->share-link#copy" aria-label="Copy event link" title="Copy event link" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-slate-300 text-slate-600 hover:bg-slate-50">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5">
          <rect x="9" y="9" width="10" height="10" rx="1" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 15H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h9a1 1 0 0 1 1 1v1" />
        </svg>
      </button>
      <span data-share-link-target="status" role="status" class="sr-only"></span>
    </section>

    <section class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between" aria-label="Add your availability">
      <div class="flex min-w-0 flex-col items-start gap-1 rounded-lg border border-dashed border-slate-700 px-3 py-2 text-sm text-slate-700 sm:flex-row sm:items-center sm:gap-2">
        <span class="font-bold">Your time zone:</span>
        <div class="flex min-w-0 items-center gap-1">
          <span class="min-w-0 truncate" data-event-response-target="timeZoneLabel"></span>
          <label for="response-time-zone" class="sr-only">Your time zone</label>
          <select id="response-time-zone" name="time_zone" required data-event-response-target="timeZone" class="sr-only"></select>
          <button type="button" aria-label="Change time zone" title="Change time zone" data-event-response-target="timeZoneButton" data-action="click->event-response#openTimeZoneSearch" class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg text-slate-500 hover:bg-slate-100 hover:text-brand-700">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="m4 16.5-.75 3.75L7 19.5 18.5 8a2.121 2.121 0 0 0-3-3L4 16.5Z" />
              <path stroke-linecap="round" d="m14 6 4 4" />
            </svg>
          </button>
        </div>
      </div>
      <button type="button" data-action="click->event-response#openCreate" class="w-full rounded-lg bg-brand-700 px-4 py-2 text-sm font-bold text-white hover:bg-brand-800 sm:w-fit">Add your availability</button>
      <div data-event-response-target="timeZoneDialog" role="dialog" aria-modal="true" aria-labelledby="response-time-zone-heading" hidden>
        <div class="fixed inset-0 z-50 flex items-center justify-center p-4">
          <div class="absolute inset-0 bg-slate-950/50" data-action="click->event-response#closeTimeZoneSearch"></div>
          <div class="relative z-10 h-[28rem] w-[calc(100%-2rem)] max-w-lg overflow-y-auto rounded-2xl bg-white p-5 shadow-2xl sm:p-6">
            <div class="flex items-center justify-between gap-4">
              <h3 id="response-time-zone-heading" class="text-lg font-bold">Search cities</h3>
              <button type="button" aria-label="Close" title="Close" class="flex h-8 w-8 items-center justify-center rounded-lg text-brand-700 hover:bg-brand-50" data-action="click->event-response#closeTimeZoneSearch">×</button>
            </div>
            <label for="response-time-zone-search" class="mt-5 block text-sm font-bold">City or country</label>
            <input id="response-time-zone-search" type="search" autocomplete="off" placeholder="Tokyo or Canada" data-event-response-target="timeZoneSearch" data-action="input->event-response#searchTimeZones" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3">
            <div data-event-response-target="timeZoneResults" class="mt-3 grid gap-2" aria-live="polite"></div>
          </div>
        </div>
      </div>

      <div data-event-response-target="responseDialog" role="dialog" aria-modal="true" aria-labelledby="availability-modal-heading" hidden>
        <div class="fixed inset-0 z-50 flex items-center justify-center p-4">
          <div class="absolute inset-0 bg-slate-950/50" data-action="click->event-response#closeResponseModal"></div>
          <div class="relative z-10 max-h-[calc(100vh-2rem)] w-[calc(100%-2rem)] max-w-lg overflow-y-auto rounded-2xl bg-white p-5 shadow-2xl sm:p-6">
            <div class="flex items-center justify-between gap-4">
              <h2 id="availability-modal-heading" data-event-response-target="modalTitle" class="text-xl font-bold">Add your availability</h2>
              <button type="button" aria-label="Close" title="Close" class="flex h-8 w-8 items-center justify-center rounded-lg text-brand-700 hover:bg-brand-50" data-action="click->event-response#closeResponseModal">×</button>
            </div>
            <form data-event-response-target="form" data-action="submit->event-response#submit" class="mt-5 grid gap-4">
              <div class="grid gap-2">
                <label for="response-name" class="text-sm font-bold">Name</label>
                <input id="response-name" name="name" type="text" required maxlength="50" data-event-response-target="name" class="rounded-lg border border-slate-300 px-3 py-2">
              </div>
              <fieldset class="grid gap-3">
                <legend class="flex w-full items-baseline justify-between gap-3 text-sm font-bold">
                  <span>Availability</span>
                  <span class="text-right text-xs font-normal text-slate-500">Times shown in <span data-event-response-target="formTimeZoneLabel"></span></span>
                </legend>
                <% @event.time_options.order(:starts_at).each do |time_option| %>
                  <div class="grid grid-cols-[minmax(0,1fr)_9rem] items-center gap-3 border-t border-slate-100 pt-3" data-time-option-id="<%= time_option.id %>">
                    <p class="min-w-0 text-sm font-bold" data-event-response-target="optionDate" data-instant="<%= time_option.starts_at.iso8601 %>"><%= time_option.starts_at.in_time_zone(@event.time_zone).strftime("%a, %b %-d, %Y, %-I:%M %p") %></p>
                    <div class="grid grid-cols-3 gap-1.5">
                      <% [["available", "✓"], ["maybe", "?"], ["unavailable", "×"]].each do |value, icon| %>
                        <label class="group flex h-12 cursor-pointer items-center justify-center rounded-lg border border-slate-300 bg-white text-xl font-bold text-slate-700 transition hover:border-brand-500 hover:bg-brand-50 has-[:checked]:border-brand-700 has-[:checked]:bg-brand-50 has-[:checked]:text-brand-700">
                          <input class="peer sr-only" type="radio" name="availability-<%= time_option.id %>" value="<%= value %>" aria-label="<%= value.humanize %>" required>
                          <span aria-hidden="true"><%= icon %></span>
                          <span class="sr-only"><%= value.humanize %></span>
                        </label>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </fieldset>
              <div class="grid gap-2">
                <label for="response-comment" class="text-sm font-bold">Comment <span class="font-normal text-slate-500">(optional)</span></label>
                <textarea id="response-comment" name="comment" rows="2" maxlength="400" data-event-response-target="comment" class="rounded-lg border border-slate-300 px-3 py-2"></textarea>
              </div>
              <button type="submit" data-event-response-target="submit" class="w-full rounded-lg bg-brand-700 px-4 py-2 text-sm font-bold text-white hover:bg-brand-800 disabled:cursor-wait disabled:opacity-60"><span data-event-response-target="submitLabel">Add response</span></button>
              <button type="button" data-event-response-target="deleteButton" data-action="click->event-response#deleteResponse" hidden class="w-full rounded-lg border border-red-200 px-4 py-2 text-sm font-bold text-red-700 hover:bg-red-50 disabled:cursor-wait disabled:opacity-60">Delete response</button>
              <p data-event-response-target="status" role="status" class="text-sm text-amber-700"></p>
            </form>
          </div>
        </div>
      </div>
    </section>


    <section class="grid gap-4" aria-labelledby="responses-heading" data-controller="candidate-share" data-candidate-share-event-time-zone-value="<%= @event.time_zone %>" data-candidate-share-respondent-time-zones-value="<%= json_escape(@responses.map(&:time_zone).to_json) %>">
      <div class="flex items-baseline justify-between gap-4">
        <h2 id="responses-heading" class="text-lg font-bold">Responses</h2>
        <span class="text-sm text-slate-500"><%= pluralize(@responses.size, "response") %></span>
      </div>
      <% if @responses.empty? %>
        <p class="text-sm text-slate-600">No responses yet.</p>
      <% end %>
      <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white lg:overflow-x-hidden">
          <table class="w-max table-fixed border-collapse text-left text-sm lg:w-full">
            <thead>
              <tr class="border-b border-slate-200 text-slate-700">
                <th scope="col" class="<%= name_column_class %> break-words px-2 py-4 text-center text-sm font-bold">Name</th>
                <% @event.time_options.order(:starts_at).each_with_index do |time_option, index| %>
                  <th scope="col" tabindex="0" role="button" aria-label="Select <%= time_option.starts_at.in_time_zone(@event.time_zone).strftime("%b %-d, %Y, %-I:%M %p") %>" data-candidate-share-column-index="<%= index %>" data-instant="<%= time_option.starts_at.iso8601 %>" data-action="mouseenter->candidate-share#highlightColumn mouseleave->candidate-share#unhighlightColumn focus->candidate-share#highlightColumn blur->candidate-share#unhighlightColumn click->candidate-share#select keydown->candidate-share#activate" class="<%= date_column_class %> cursor-pointer border-l border-slate-200 px-1 py-3 text-center text-xs font-bold transition-colors focus:bg-brand-50 focus:outline-none">
                    <span data-event-response-target="responseDate" data-instant="<%= time_option.starts_at.iso8601 %>"><%= time_option.starts_at.in_time_zone(@event.time_zone).strftime("%b %-d, %Y, %-I:%M %p") %></span>
                  </th>
                <% end %>
                <th scope="col" class="<%= comment_column_class %> border-l border-slate-200 px-2 py-4 text-center text-sm font-bold">Comment</th>
              </tr>
            </thead>
            <tbody>
              <% @responses.each do |response| %>
                <% votes_by_time_option = response.votes.index_by(&:time_option_id) %>
                <tr class="border-b border-slate-200 last:border-b-0">
                  <th scope="row" class="break-all px-2 py-4 text-center align-middle text-sm font-bold sm:break-words">
                    <% response_choices = response.votes.each_with_object({}) { |vote, choices| choices[vote.time_option_id] = vote.availability } %>
                    <button type="button" data-action="click->event-response#edit" data-response-id="<%= response.id %>" data-response-name="<%= response.name %>" data-response-time-zone="<%= response.time_zone %>" data-response-comment="<%= response.comment %>" data-response-choices="<%= json_escape(response_choices.to_json) %>" class="group block min-w-0 max-w-full cursor-pointer text-left text-slate-900 hover:text-brand-700">
                      <span class="block"><%= response.name %></span>
                      <span class="mt-1 block text-xs font-normal text-slate-500 group-hover:text-brand-700"><%= city_name_for_time_zone(response.time_zone) %></span>
                    </button>
                  </th>
                  <% @event.time_options.order(:starts_at).each_with_index do |time_option, index| %>
                    <% vote = votes_by_time_option[time_option.id] %>
                    <td tabindex="0" role="button" aria-label="<%= availability_label(vote&.availability) %>" title="Select <%= time_option.starts_at.in_time_zone(@event.time_zone).strftime("%b %-d, %Y, %-I:%M %p") %>" data-candidate-share-column-index="<%= index %>" data-instant="<%= time_option.starts_at.iso8601 %>" data-action="mouseenter->candidate-share#highlightColumn mouseleave->candidate-share#unhighlightColumn focus->candidate-share#highlightColumn blur->candidate-share#unhighlightColumn click->candidate-share#select keydown->candidate-share#activate" class="<%= date_column_class %> cursor-pointer border-l border-slate-200 px-1 py-4 text-center text-xl font-bold transition-colors focus:bg-brand-50 focus:outline-none">
                      <%= availability_symbol(vote&.availability) %>
                    </td>
                  <% end %>
                  <td class="<%= comment_column_class %> break-words border-l border-slate-200 px-2 py-4 text-sm text-slate-600"><%= response.comment %></td>
                </tr>
              <% end %>
            </tbody>
            <tfoot>
              <tr class="border-t border-slate-200 text-orange-700">
                <th scope="row" class="whitespace-nowrap px-2 py-4 text-center text-sm font-bold">Available</th>
                <% time_options.each_with_index do |time_option, index| %>
                  <% available_count = available_counts.fetch(time_option.id) %>
                  <% count_weight = maximum_available&.positive? && available_count == maximum_available ? "font-bold" : "font-normal" %>
                  <td tabindex="0" role="button" aria-label="Select <%= time_option.starts_at.in_time_zone(@event.time_zone).strftime("%b %-d, %Y, %-I:%M %p") %>" data-candidate-share-column-index="<%= index %>" data-instant="<%= time_option.starts_at.iso8601 %>" data-action="mouseenter->candidate-share#highlightColumn mouseleave->candidate-share#unhighlightColumn focus->candidate-share#highlightColumn blur->candidate-share#unhighlightColumn click->candidate-share#select keydown->candidate-share#activate" class="<%= date_column_class %> cursor-pointer border-l border-slate-200 px-1 py-4 text-center text-lg <%= count_weight %> transition-colors focus:bg-brand-50 focus:outline-none"><%= available_count %></td>
                <% end %>
                <td class="border-l border-slate-200"></td>
              </tr>
            </tfoot>
          </table>
      </div>
      <div data-candidate-share-target="dialog" role="dialog" aria-modal="true" aria-labelledby="candidate-share-heading" class="fixed inset-0 z-50 flex items-center justify-center p-4" hidden>
        <div class="absolute inset-0 bg-slate-950/50" data-action="click->candidate-share#close"></div>
        <div class="relative z-10 max-h-[calc(100vh-2rem)] w-[calc(100%-2rem)] max-w-lg overflow-y-auto rounded-2xl bg-white p-5 shadow-2xl sm:p-6">
          <div class="flex items-center justify-between gap-4">
            <h2 id="candidate-share-heading" class="text-xl font-bold">Selected time</h2>
            <button type="button" aria-label="Close" title="Close" class="flex h-8 w-8 items-center justify-center rounded-lg text-brand-700 hover:bg-brand-50" data-action="click->candidate-share#close">×</button>
          </div>
          <p data-candidate-share-target="date" class="mt-5 text-lg font-bold text-slate-900"></p>
          <label for="candidate-share-text" class="sr-only">Times to share</label>
          <textarea id="candidate-share-text" data-candidate-share-target="times" rows="4" class="mt-4 w-full resize-none rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-700"></textarea>
          <div class="relative mt-6">
            <button type="button" data-candidate-share-target="copy" data-action="click->candidate-share#copy" class="w-full rounded-lg bg-brand-700 px-4 py-2 text-sm font-bold text-white hover:bg-brand-800 disabled:cursor-wait disabled:opacity-60">Copy as text</button>
            <p data-candidate-share-target="status" role="status" class="pointer-events-none absolute bottom-full right-0 mb-2 whitespace-nowrap rounded-lg bg-slate-900 px-3 py-2 text-xs text-white opacity-0 shadow-lg"></p>
          </div>
        </div>
      </div>
    </section>

    <p class="text-xs text-slate-500">This page and its responses may be deleted after one year.</p>

    <% if management_authorized?(@event) %>
      <section class="grid gap-3 border-t border-slate-200 pt-6" aria-labelledby="delete-event-heading">
        <h2 id="delete-event-heading" class="text-lg font-bold">Delete event</h2>
        <p class="text-sm text-slate-600">This will permanently delete this page, all time options, responses, and comments.</p>
        <%= button_to "Delete event", event_path(@event.public_token), method: :delete, data: { turbo_confirm: "Delete #{@event.name}? This will permanently delete the event and all responses." }, authenticity_token: false, class: "w-fit rounded-lg bg-red-700 px-4 py-2 text-sm font-bold text-white hover:bg-red-800" %>
      </section>
    <% end %>
  </main>
</div>
